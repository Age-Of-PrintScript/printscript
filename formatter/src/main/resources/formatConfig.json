{
    "declarationTuple" : {
        "ast": "declaration",
        "rules": [
            {"spaceAfterColon": true},
            {"spaceBeforeColon": true}
        ]
    },
    "callTuple" : {
        "ast": "call",
        "rules": [
            {"linesAfterCall" : 2}
        ]
    },
    "assignmentTuple" : {
        "ast": "assignment",
        "rules": [
            {"spacesAroundAssign" :  true}
        ]
    }
}


